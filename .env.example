# ===================================================
# KrishiSeva Production / Vercel Environment Variables
# ===================================================

# [REQUIRED FOR SECURE JWT AUTH]
# Replace with any strong random string in Vercel Settings
JWT_SECRET=krishiseva-super-secret-production-jwt-key-2026

# [OPTIONAL / DATABASE]
# If not provided, KrishiSeva automatically operates on its resilient In-Memory Store!
# For persistent data across serverless cold starts, use any hosted Postgres (e.g. Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/krishidb?sslmode=require

# [OPTIONAL / CACHE]
# REDIS_URL=rediss://default:password@your-redis-host.upstash.io:6379

# [OPTIONAL / SYSTEM SETTINGS]
NODE_ENV=production
PORT=4000
